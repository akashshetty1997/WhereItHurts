# Copy to backend/.env. Never commit .env.

# Smart extraction (/api/extract/smart): which Claude to use.
#   claude_code = your Claude Code login on this machine (no API key needed)
#   api         = the Anthropic API, needs ANTHROPIC_API_KEY below
#   off         = keywords only
LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=

# Speech-to-text for /api/transcribe. Needs the models in backend/models (see README).
TRANSCRIBE_ENABLED=true
TRANSCRIBE_ENGINE=parakeet
